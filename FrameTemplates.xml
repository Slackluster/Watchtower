<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<Frame name="Watchtower_SettingsText" mixin="Watchtower_SettingsTextMixin" virtual="true">
		<Size y="28" />
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="LeftText" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT" x="37" y="-8" />
					</Anchors>
				</FontString>
				<FontString parentKey="MiddleText" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT" x="240" y="-8" />
					</Anchors>
				</FontString>
				<FontString parentKey="RightText" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT" x="280" y="-8" />
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="Watchtower_SettingsExpandTemplate" inherits="SettingsExpandableSectionTemplate" mixin="Watchtower_SettingsExpandMixin" virtual="true">
		<Size y="24" />
	</Frame>

	<Button name="Watchtower_ListButton" virtual="true">
		<Size x="200" y="20" />
		<HighlightTexture atlas="Options_List_Hover" setAllPoints="true" />
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="LeftText1" inherits="GameFontNormalMed1" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" x="2" />
					</Anchors>
					<Size x="400" y="24" />
				</FontString>
				<FontString parentKey="LeftText2" inherits="GameFontNormalMed1" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" x="24" y="1" />
						<Anchor point="RIGHT" x="-4" />
					</Anchors>
					<Size x="400" y="24" />
				</FontString>
			</Layer>
		</Layers>
	</Button>

	<Button name="Watchtower_TrackerItem" virtual="true">
		<Size x="0" y="30" />
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Text" inherits="GameFontNormal" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" x="0" />
					</Anchors>
					<Size x="0" y="0" />
				</FontString>
			</Layer>
		</Layers>
	</Button>

	<Button name="Watchtower_LoadCondition" virtual="true">
		<Size x="200" y="40" />
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Icon" inherits="GameFontNormalHuge" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" x="0" />
					</Anchors>
					<Size x="40" y="40" />
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<DropdownButton parentKey="Dropdown1" inherits="WowStyle1DropdownTemplate">
				<Size x="100" y="25" />
				<Anchors>
					<Anchor point="LEFT" x="25" y="0" />
				</Anchors>
			</DropdownButton>
			<DropdownButton parentKey="Dropdown2" inherits="WowStyle1DropdownTemplate">
				<Size x="140" y="25" />
				<Anchors>
					<Anchor point="LEFT" x="135" y="0" />
				</Anchors>
			</DropdownButton>
			<DropdownButton parentKey="Dropdown3" inherits="WowStyle1DropdownTemplate">
				<Size x="135" y="25" />
				<Anchors>
					<Anchor point="LEFT" x="285" y="0" />
				</Anchors>
			</DropdownButton>
			<EditBox parentKey="Editbox1" inherits="InputBoxTemplate" autoFocus="false" letters="30">
				<Size x="130" y="30"/>
				<Anchors>
					<Anchor point="LEFT" x="290" y="0" />
				</Anchors>
				<Scripts>
					<OnEnterPressed>
						self:ClearFocus()
					</OnEnterPressed>
					<OnEscapePressed>
						self:ClearFocus()
					</OnEscapePressed>
				</Scripts>
			</EditBox>
			<Button parentKey="AddButton" inherits="UIButtonTemplate">
				<Size x="30" y="30"/>
				<Anchors>
					<Anchor point="RIGHT" x="-10" y="0"/>
				</Anchors>
				<KeyValues>
					<KeyValue key="buttonArtKit" value="128-redbutton-plus" type="string"/>
				</KeyValues>
			</Button>
			<Button parentKey="RemoveButton" inherits="UIButtonTemplate">
				<Size x="30" y="30"/>
				<Anchors>
					<Anchor point="RIGHT" x="-45" y="0"/>
				</Anchors>
				<KeyValues>
					<KeyValue key="buttonArtKit" value="128-redbutton-minus" type="string"/>
				</KeyValues>
			</Button>
		</Frames>
	</Button>
</Ui>
